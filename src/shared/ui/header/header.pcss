.header {
  padding-block: 1.5rem;
  text-align: center;
  width: 100%;
  
  &__stats {
    font-family: var(--mono);
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-gray-900);
  }
  
  &__pct {
    color: var(--color-indigo-500);
  }
}
