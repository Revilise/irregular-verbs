.input {
  font: inherit;
  font-family: var(--mono);
  padding: 0.75rem 0.9rem;
  border-radius: 10px;
  border: 1px solid var(--color-border);
  background: var(--color-bg-elevated);
  color: var(--color-text-heading);

  &:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  &:disabled {
    opacity: 0.7;
  }
}

