.feedback {
  margin-top: 1.25rem;
  padding-top: 1.1rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.feedback--ok .feedback__title {
  color: var(--color-success);
}

.feedback--bad .feedback__title {
  color: var(--color-danger);
}

.feedback__title {
  margin: 0;
  font-weight: 650;
}

.feedback__answer {
  margin: 0;
  font-size: 0.95rem;
  color: var(--color-text-heading);
}

