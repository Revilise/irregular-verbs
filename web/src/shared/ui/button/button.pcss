.btn {
  --btnFont: inherit;
  --btnFontWeight: 600;
  --btnFontSize: 1rem;
  --btnTextAlign: center;

  --btnPadX: 1rem;
  --btnPadY: 0.65rem;
  --btnBorderRad: 0.5rem;
  --btnBorderWidth: 1px;

  --btnCurColor: var(--btnColor);
  --btnColor: var(--color-white);
  --btnHoverColor: var(--color-white);
  --btnActiveColor: var(--color-white);
  --btnDisabledColor: var(--color-white);

  --btnCurBg: var(--btnBg);
  --btnBg: var(--gradient-indigo);
  --btnHoverBg: var(--gradient-indigo);
  --btnActiveBg: var(--gradient-indigo);
  --btnDisabledBg: var(--gradient-indigo);

  --btnCurBorderColor: var(--btnBorderColor);
  --btnBorderColor: transparent;
  --btnHoverBorderColor: transparent;
  --btnActiveBorderColor: transparent;
  --btnDisabledBorderColor: transparent;

  --btnShadow: 0 2px 12px var(--color-indigo-500-alpha-35);
  --btnOpacity: 1;
  --btnCursor: pointer;
  --btnFilter: none;
  --btnTransition: 0.2s all;
  --btnPointerEvents: all;

  /* loader */
  --btnLoaderOpacity: 0;

  /* label */
  --btnLabelOpacity: 1;

  background: var(--btnCurBg);
  color: var(--btnCurColor);
  border: var(--btnCurBorderColor) var(--btnBorderWidth) solid;

  font: var(--btnFont);
  font-size: var(--btnFontSize);
  font-weight: var(--btnFontWeight);
  text-align: var(--btnTextAlign);

  padding-inline: var(--btnPadX);
  padding-block: var(--btnPadY);
  border-radius: var(--btnBorderRad);

  box-shadow: var(--btnShadow);
  opacity: var(--btnOpacity);
  cursor: var(--btnCursor);
  filter: var(--btnFilter);
  transition: var(--btnTransition);
  pointer-events: var(--btnPointerEvents);
  position: relative;

  &:hover:not(:disabled) {
    --btnCurBg: var(--btnHoverBg);
    --btnCurColor: var(--btnHoverColor);
    --btnCurBorderColor: var(--btnHoverBorderColor);

    --btnFilter: brightness(1.05);
  }

  &__label {
    opacity: var(--btnLabelOpacity);
    transition: opacity .2s;
    color: inherit;
    font-size: inherit;
  }

  &__loader {
    opacity: var(--btnLoaderOpacity);
    transition: opacity .2s;
    display: flex;
    place-items: center;
    place-content: center;
    inset: 0;
    width: 100%;
    height: 100%;
    position: absolute;

    @mixin loader var(--btnFontSize), var(--btnColor), var(--btnCurBg);
  }

  &:disabled {
    --btnCurBg: var(--btnDisabledBg);
    --btnCurColor: var(--btnDisabledColor);
    --btnCurBorderColor: var(--btnDisabledBorderColor);

    --btnOpacity: 0.45;
    --btnCursor: not-allowed;
    --btnShadow: none;
  }

  &.isLoading,
  &--isLoading {
    --btnLoaderOpacity: 1;
    --btnLabelOpacity: 0;
    --btnPointerEvents: none;
  }

  &--isChoice {
    --btnTextAlign: left;
    --btnPadY: 0.75rem;

    --btnBg: var(--color-white);
    --btnHoverBg: var(--color-indigo-500-alpha-10);

    --btnBorderColor: var(--color-slate-200);
    --btnHoverBorderColor: var(--color-indigo-500-alpha-45);

    --btnColor: var(--color-gray-900);

    --btnTransition: border-color 0.15s, background 0.15s, transform 0.08s;

    &:active:not(:disabled) {
      transform: scale(0.99);
    }

    &:disabled {
      --btnOpacity: 0.65;
      --btnCursor: default;
    }
  }
}
