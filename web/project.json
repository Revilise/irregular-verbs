{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "projectType": "application",
  "sourceRoot": "web/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/.env*",
        {
          "env": "VITE_API"
        },
        {
          "env": "NODE_ENV"
        }
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "npm run build",
        "cwd": "web"
      }
    }
  }
}
